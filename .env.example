# Application
APP_NAME=Aereo Geospatial Measurement API
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# PostgreSQL / PostGIS
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_NAME=aereo_measurements
DATABASE_USER=aereo
DATABASE_PASSWORD=aereo_dev_password
DATABASE_ECHO=false

# Uploads
UPLOAD_DIRECTORY=data/uploads
MAX_UPLOAD_SIZE_BYTES=10485760
MAX_ZIP_UNCOMPRESSED_SIZE_BYTES=52428800
ALLOWED_UPLOAD_EXTENSIONS=[".kml", ".zip"]
